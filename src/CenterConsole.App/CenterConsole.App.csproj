<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>CenterConsole</AssemblyName>
    <RootNamespace>CenterConsole.App</RootNamespace>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CenterConsole.Core\CenterConsole.Core.csproj" />
  </ItemGroup>

  <!-- TarkovAudio.dll: native VST plugin hosted by Equalizer APO. Built with MSVC via build.cmd and shipped
       next to CenterConsole.exe, which installs it into Equalizer APO from the Compressor tab. -->
  <PropertyGroup>
    <TarkovAudioDir>$(MSBuildThisFileDirectory)..\..\native\TarkovAudio\</TarkovAudioDir>
    <TarkovAudioDll>$(TarkovAudioDir)bin\TarkovAudio.dll</TarkovAudioDll>
  </PropertyGroup>

  <Target Name="BuildTarkovAudio" BeforeTargets="BeforeBuild"
          Inputs="$(TarkovAudioDir)TarkovAudio.cpp;$(TarkovAudioDir)TarkovDsp.h;$(TarkovAudioDir)vst2_min.h"
          Outputs="$(TarkovAudioDll)">
    <Exec Command="&quot;$(TarkovAudioDir)build.cmd&quot;" ContinueOnError="WarnAndContinue" />
  </Target>

  <Target Name="IncludeTarkovAudio" AfterTargets="BuildTarkovAudio" Condition="Exists('$(TarkovAudioDll)')">
    <ItemGroup>
      <None Include="$(TarkovAudioDll)" Link="TarkovAudio.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
