<Window x:Class="CenterConsole.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CenterConsole.App.Views"
        xmlns:conv="clr-namespace:CenterConsole.App.Converters"
        Title="CenterConsole" Height="520" Width="640"
        WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing"
        ShowInTaskbar="True">
    <Window.Resources>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:BoolToInactiveOpacityConverter x:Key="BoolToInactiveOpacity"/>
    </Window.Resources>
    <DockPanel>
    <TextBlock x:Name="VersionLabel" DockPanel.Dock="Bottom"
               HorizontalAlignment="Right" Margin="0,0,10,4"
               Foreground="Gray" FontSize="11"/>
    <TabControl Margin="8">

        <TabItem Header="General">
            <StackPanel Margin="16">
                <CheckBox Content="Launch CenterConsole when Windows starts"
                          IsChecked="{Binding RunAtStartup}"/>
                <TextBlock Margin="24,4,0,0" Foreground="Gray" TextWrapping="Wrap" MaxWidth="450" HorizontalAlignment="Left"
                           Text="Registered as a scheduled task that runs elevated at logon, so it starts without a UAC prompt every time."/>
            </StackPanel>
        </TabItem>

        <TabItem Header="Microphone">
            <StackPanel Margin="16">
                <TextBlock Text="Capture device" FontWeight="Bold" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Microphone.Devices}"
                          SelectedItem="{Binding Microphone.SelectedDevice}"
                          DisplayMemberPath="FriendlyName"
                          Width="360" HorizontalAlignment="Left"/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <CheckBox Content="Muted"
                              IsChecked="{Binding Microphone.IsMuted, Mode=OneWay}"
                              Click="OnMuteCheckboxClick"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox Content="Mute automatically on launch"
                              IsChecked="{Binding Microphone.MuteOnStartup}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <TextBlock Text="Mute hotkey:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <views:HotkeyCaptureControl x:Name="MicMuteHotkeyControl"
                                                 BindingValue="{Binding Microphone.MuteHotkey, Mode=TwoWay}"
                                                 HotkeyCaptured="OnMicMuteHotkeyCaptured"/>
                </StackPanel>
            </StackPanel>
        </TabItem>

        <TabItem Header="Camera Block">
            <DockPanel Margin="16">
                <TextBlock DockPanel.Dock="Top"
                           Foreground="DarkRed"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Visibility="{Binding CameraBlock.IsElevated, Converter={StaticResource InverseBoolToVisibility}}"
                           Text="Not running as Administrator. Camera blocking is disabled. Restart CenterConsole elevated to use this feature."/>

                <CheckBox DockPanel.Dock="Bottom" Margin="0,12,0,0"
                          Content="Re-apply blocks automatically on startup"
                          IsChecked="{Binding CameraBlock.AutoApplyOnStartup}"/>

                <ListView ItemsSource="{Binding CameraBlock.Devices}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Block" Width="50">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsBlocked}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Device" Width="320" DisplayMemberBinding="{Binding Device.FriendlyName}"/>
                            <GridViewColumn Header="Class" Width="120" DisplayMemberBinding="{Binding Device.DeviceClassName}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </TabItem>

        <TabItem Header="Per-App Volume">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="Volume up:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <views:HotkeyCaptureControl BindingValue="{Binding AppVolume.VolumeUpHotkey, Mode=TwoWay}"
                                                 HotkeyCaptured="OnVolumeUpHotkeyCaptured"/>
                    <TextBlock Text="Volume down:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <views:HotkeyCaptureControl BindingValue="{Binding AppVolume.VolumeDownHotkey, Mode=TwoWay}"
                                                 HotkeyCaptured="OnVolumeDownHotkeyCaptured"/>
                    <TextBlock Text="Step %:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <TextBox Text="{Binding AppVolume.StepPercent}" Width="40"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="Gray"
                           Text="Select 'Target' on the app the volume hotkeys should control."/>

                <ItemsControl ItemsSource="{Binding AppVolume.Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="0,8">
                                <Grid Opacity="{Binding IsLive, Converter={StaticResource BoolToInactiveOpacity}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton GroupName="VolumeTarget" Content="Target" VerticalAlignment="Center"
                                                 IsChecked="{Binding IsHotkeyTarget}" Grid.Column="0"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="1">
                                        <TextBlock Text="{Binding ProcessName}"/>
                                        <TextBlock Text=" (no audio yet)" FontStyle="Italic"
                                                   Visibility="{Binding IsLive, Converter={StaticResource InverseBoolToVisibility}}"/>
                                    </StackPanel>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding VolumePercent}"
                                            IsEnabled="{Binding IsLive}"
                                            VerticalAlignment="Center" Grid.Column="2"/>
                                    <TextBlock Text="{Binding VolumePercent, StringFormat={}{0:0}%}"
                                               VerticalAlignment="Center" Grid.Column="3"/>
                                    <CheckBox Content="Mute" IsChecked="{Binding IsMuted}"
                                              IsEnabled="{Binding IsLive}"
                                              VerticalAlignment="Center" Grid.Column="4"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </TabItem>

    </TabControl>
    </DockPanel>
</Window>
